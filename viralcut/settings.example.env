# Copy this file to settings.env (same folder) and fill in what you need.
# settings.env is ignored by git, so your key stays on your computer.

# Your Claude API key from https://console.anthropic.com - gives the best clip picks, posts and hashtags.
# Leave empty to use the free offline mode.
ANTHROPIC_API_KEY=

# Speech recognition size: tiny, base, small (default), medium, large-v3
VIRALCUT_WHISPER_MODEL=small
